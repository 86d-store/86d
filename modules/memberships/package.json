{
	"name": "@86d-app/memberships",
	"version": "0.0.42",
	"description": "Paid membership plans — recurring subscriptions with exclusive benefits, gated products, and member pricing",
	"keywords": [
		"commerce",
		"memberships",
		"subscriptions",
		"member-pricing",
		"gated-products"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/memberships"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/membership-admin": {
			"types": "./src/admin/components/membership-admin.tsx",
			"default": "./src/admin/components/membership-admin.tsx"
		},
		"./admin/components/membership-plans": {
			"types": "./src/admin/components/membership-plans.tsx",
			"default": "./src/admin/components/membership-plans.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "86d module build",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"86d": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"next": "catalog:next",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"next": "catalog:next",
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./*": "./dist/*",
			"./admin/components/membership-admin": {
				"types": "./dist/admin/components/membership-admin.d.ts",
				"default": "./dist/admin/components/membership-admin.js"
			},
			"./admin/components/membership-plans": {
				"types": "./dist/admin/components/membership-plans.d.ts",
				"default": "./dist/admin/components/membership-plans.js"
			},
			"./components": {
				"types": "./dist/store/components/mdx.d.ts",
				"default": "./dist/store/components/mdx.js"
			}
		}
	}
}
