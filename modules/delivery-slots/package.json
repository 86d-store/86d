{
	"name": "@86d-app/delivery-slots",
	"version": "0.0.41",
	"description": "Delivery slots — define delivery time windows by day of week with capacity limits, surcharges, and blackout dates",
	"keywords": [
		"commerce",
		"delivery-slots",
		"delivery",
		"scheduling",
		"time-windows",
		"click-and-collect"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/delivery-slots"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/blackout-list": {
			"types": "./src/admin/components/blackout-list.tsx",
			"default": "./src/admin/components/blackout-list.tsx"
		},
		"./admin/components/booking-list": {
			"types": "./src/admin/components/booking-list.tsx",
			"default": "./src/admin/components/booking-list.tsx"
		},
		"./admin/components/schedule-detail": {
			"types": "./src/admin/components/schedule-detail.tsx",
			"default": "./src/admin/components/schedule-detail.tsx"
		},
		"./admin/components/schedule-list": {
			"types": "./src/admin/components/schedule-list.tsx",
			"default": "./src/admin/components/schedule-list.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	}
}
