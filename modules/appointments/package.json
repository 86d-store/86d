{
	"name": "@86d-app/appointments",
	"version": "0.0.41",
	"description": "Appointments — service-based booking with staff scheduling, time slots, and customer appointment management",
	"keywords": [
		"commerce",
		"appointments",
		"booking",
		"scheduling",
		"services",
		"staff",
		"calendar"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/appointments"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/appointment-detail": {
			"types": "./src/admin/components/appointment-detail.tsx",
			"default": "./src/admin/components/appointment-detail.tsx"
		},
		"./admin/components/appointment-list": {
			"types": "./src/admin/components/appointment-list.tsx",
			"default": "./src/admin/components/appointment-list.tsx"
		},
		"./admin/components/service-list": {
			"types": "./src/admin/components/service-list.tsx",
			"default": "./src/admin/components/service-list.tsx"
		},
		"./admin/components/staff-list": {
			"types": "./src/admin/components/staff-list.tsx",
			"default": "./src/admin/components/staff-list.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	}
}
