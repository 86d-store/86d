{
	"name": "@86d-app/referrals",
	"version": "0.1.0",
	"description": "Customer referral program module for 86d commerce platform",
	"keywords": [
		"commerce",
		"referrals",
		"referral-program",
		"growth",
		"86d"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/referrals"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/code-list": {
			"types": "./src/admin/components/code-list.tsx",
			"default": "./src/admin/components/code-list.tsx"
		},
		"./admin/components/referral-list": {
			"types": "./src/admin/components/referral-list.tsx",
			"default": "./src/admin/components/referral-list.tsx"
		},
		"./admin/components/reward-rules": {
			"types": "./src/admin/components/reward-rules.tsx",
			"default": "./src/admin/components/reward-rules.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	}
}
