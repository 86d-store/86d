{
	"name": "@86d-app/price-lists",
	"version": "0.0.42",
	"description": "Price list management — B2B/wholesale pricing, volume tiers, customer-group-specific pricing, and scheduled price overrides",
	"keywords": [
		"commerce",
		"price-lists",
		"wholesale",
		"b2b",
		"pricing",
		"volume-pricing",
		"tiered-pricing"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/price-lists"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/price-list-admin": {
			"types": "./src/admin/components/price-list-admin.tsx",
			"default": "./src/admin/components/price-list-admin.tsx"
		},
		"./admin/components/price-list-create": {
			"types": "./src/admin/components/price-list-create.tsx",
			"default": "./src/admin/components/price-list-create.tsx"
		},
		"./admin/components/price-list-detail": {
			"types": "./src/admin/components/price-list-detail.tsx",
			"default": "./src/admin/components/price-list-detail.tsx"
		},
		"./capabilities": "./src/capabilities.ts",
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"86d": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./*": "./dist/*",
			"./admin/components/price-list-admin": {
				"types": "./dist/admin/components/price-list-admin.d.ts",
				"default": "./dist/admin/components/price-list-admin.js"
			},
			"./admin/components/price-list-create": {
				"types": "./dist/admin/components/price-list-create.d.ts",
				"default": "./dist/admin/components/price-list-create.js"
			},
			"./admin/components/price-list-detail": {
				"types": "./dist/admin/components/price-list-detail.d.ts",
				"default": "./dist/admin/components/price-list-detail.js"
			},
			"./capabilities": {
				"types": "./dist/capabilities.d.ts",
				"default": "./dist/capabilities.js"
			},
			"./components": {
				"types": "./dist/store/components/mdx.d.ts",
				"default": "./dist/store/components/mdx.js"
			}
		}
	}
}
