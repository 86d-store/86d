{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"src/**/__tests__",
		"src/**/*.test.ts",
		"src/**/*.test.tsx"
	]
}
