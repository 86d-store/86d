{
	"name": "@86d-app/faq",
	"version": "0.0.42",
	"description": "FAQ and knowledge base module for 86d commerce platform",
	"keywords": [
		"commerce",
		"faq",
		"knowledge-base",
		"help",
		"86d"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/faq"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/faq-categories": {
			"types": "./src/admin/components/faq-categories.tsx",
			"default": "./src/admin/components/faq-categories.tsx"
		},
		"./admin/components/faq-category-detail": {
			"types": "./src/admin/components/faq-category-detail.tsx",
			"default": "./src/admin/components/faq-category-detail.tsx"
		},
		"./admin/components/faq-detail": {
			"types": "./src/admin/components/faq-detail.tsx",
			"default": "./src/admin/components/faq-detail.tsx"
		},
		"./admin/components/faq-list": {
			"types": "./src/admin/components/faq-list.tsx",
			"default": "./src/admin/components/faq-list.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"86d": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./*": "./dist/*",
			"./admin/components/faq-categories": {
				"types": "./dist/admin/components/faq-categories.d.ts",
				"default": "./dist/admin/components/faq-categories.js"
			},
			"./admin/components/faq-category-detail": {
				"types": "./dist/admin/components/faq-category-detail.d.ts",
				"default": "./dist/admin/components/faq-category-detail.js"
			},
			"./admin/components/faq-detail": {
				"types": "./dist/admin/components/faq-detail.d.ts",
				"default": "./dist/admin/components/faq-detail.js"
			},
			"./admin/components/faq-list": {
				"types": "./dist/admin/components/faq-list.d.ts",
				"default": "./dist/admin/components/faq-list.js"
			},
			"./components": {
				"types": "./dist/store/components/mdx.d.ts",
				"default": "./dist/store/components/mdx.js"
			}
		}
	}
}
