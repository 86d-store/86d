{
	"name": "@86d-app/products",
	"version": "0.0.41",
	"description": "Product catalog module for 86d commerce platform",
	"keywords": [
		"commerce",
		"products",
		"catalog",
		"categories",
		"86d"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/products"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/categories-admin": {
			"types": "./src/admin/components/categories-admin.tsx",
			"default": "./src/admin/components/categories-admin.tsx"
		},
		"./admin/components/product-detail": {
			"types": "./src/admin/components/product-detail.tsx",
			"default": "./src/admin/components/product-detail.tsx"
		},
		"./admin/components/product-edit": {
			"types": "./src/admin/components/product-edit.tsx",
			"default": "./src/admin/components/product-edit.tsx"
		},
		"./admin/components/product-list": {
			"types": "./src/admin/components/product-list.tsx",
			"default": "./src/admin/components/product-list.tsx"
		},
		"./admin/components/product-new": {
			"types": "./src/admin/components/product-new.tsx",
			"default": "./src/admin/components/product-new.tsx"
		},
		"./capabilities": "./src/capabilities.ts",
		"./catalog-presentation": {
			"types": "./src/catalog-presentation.ts",
			"default": "./src/catalog-presentation.ts"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		},
		"./state": {
			"types": "./src/state.ts",
			"default": "./src/state.ts"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "86d module build",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-table": "9.1.2"
	},
	"devDependencies": {
		"86d": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"next": "catalog:next",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"next": "catalog:next",
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./*": "./dist/*",
			"./admin/components/categories-admin": {
				"types": "./dist/admin/components/categories-admin.d.ts",
				"default": "./dist/admin/components/categories-admin.js"
			},
			"./admin/components/product-detail": {
				"types": "./dist/admin/components/product-detail.d.ts",
				"default": "./dist/admin/components/product-detail.js"
			},
			"./admin/components/product-edit": {
				"types": "./dist/admin/components/product-edit.d.ts",
				"default": "./dist/admin/components/product-edit.js"
			},
			"./admin/components/product-list": {
				"types": "./dist/admin/components/product-list.d.ts",
				"default": "./dist/admin/components/product-list.js"
			},
			"./admin/components/product-new": {
				"types": "./dist/admin/components/product-new.d.ts",
				"default": "./dist/admin/components/product-new.js"
			},
			"./capabilities": {
				"types": "./dist/capabilities.d.ts",
				"default": "./dist/capabilities.js"
			},
			"./catalog-presentation": {
				"types": "./dist/catalog-presentation.d.ts",
				"default": "./dist/catalog-presentation.js"
			},
			"./components": {
				"types": "./dist/store/components/mdx.d.ts",
				"default": "./dist/store/components/mdx.js"
			},
			"./state": {
				"types": "./dist/state.d.ts",
				"default": "./dist/state.js"
			}
		}
	}
}
