{
	"name": "@86d-app/gift-registry",
	"version": "0.0.42",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "modules/gift-registry"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*",
		"./admin/components/registries-list": {
			"types": "./src/admin/components/registries-list.tsx",
			"default": "./src/admin/components/registries-list.tsx"
		},
		"./admin/components/registry-detail": {
			"types": "./src/admin/components/registry-detail.tsx",
			"default": "./src/admin/components/registry-detail.tsx"
		},
		"./components": {
			"types": "./src/store/components/mdx.tsx",
			"default": "./src/store/components/mdx.tsx"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*"
	},
	"devDependencies": {
		"86d": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/mdx": "catalog:mdx",
		"@types/react": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"react": "catalog:react"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./*": "./dist/*",
			"./admin/components/registries-list": {
				"types": "./dist/admin/components/registries-list.d.ts",
				"default": "./dist/admin/components/registries-list.js"
			},
			"./admin/components/registry-detail": {
				"types": "./dist/admin/components/registry-detail.d.ts",
				"default": "./dist/admin/components/registry-detail.js"
			},
			"./components": {
				"types": "./dist/store/components/mdx.d.ts",
				"default": "./dist/store/components/mdx.js"
			}
		}
	}
}
