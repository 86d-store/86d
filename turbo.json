{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalEnv": [
        "NODE_ENV",
        "ENABLE_EXPERIMENTAL_COREPACK",
        "VERCEL_FORCE_NO_BUILD_CACHE",
        "APP_URL",
        "SITE_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "STORE_ID",
        "86D_STORE_ID",
        "86D_API_URL",
        "86D_WORKLOAD_CREDENTIAL",
        "86D_TELEMETRY",
        "86D_ADMIN_OAUTH_CLIENT_ID",
        "86D_ADMIN_OAUTH_CLIENT_SECRET",
        "86D_PAYMENTS_LIVE_ACTIVATION",
        "STORAGE_CLIENT",
        "STORAGE_LOCAL_DIR",
        "STORAGE_LOCAL_BASE_URL",
        "STORAGE_PUBLIC_URL_MODE",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_VIRTUAL_HOSTED_STYLE",
        "BLOB_READ_WRITE_TOKEN",
        "VERCEL_BLOB_STORAGE_HOSTNAME",
        "RESEND_API_KEY",
        "SENTRY_DSN",
        "GITHUB_TOKEN",
        "LOG_LEVEL",
        "PORT",
        "RAILWAY_PUBLIC_DOMAIN",
        "APP_ADMIN_EMAIL",
        "APP_ADMIN_PASSWORD",
        "DURABLE_EVENT_MAX_BATCHES",
        "DOCKER_BUILD",
        "VERCEL_ENV",
        "VERCEL_URL",
        "NEXT_PUBLIC_*",
        "CI"
    ],
    "globalPassThroughEnv": [
        "COREPACK_HOME",
        "FORCE_COLOR",
        "NO_COLOR",
        "NEXT_RUNTIME",
        "PLAYWRIGHT_START_SERVER",
        "E2E_STORE_URL",
        "E2E_ADMIN_EMAIL",
        "E2E_ADMIN_PASSWORD",
        "E2E_VISUAL"
    ],
    "globalDependencies": [
        ".env",
        ".env.local",
        ".env.development.local",
        ".env.test.local",
        ".env.production.local"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "build/**"
            ]
        },
        "store#dev": {
            "cache": false,
            "persistent": true,
            "env": [
                "STORE_ID"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "check": {
            "outputs": []
        },
        "check:fix": {
            "cache": false,
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        }
    }
}
