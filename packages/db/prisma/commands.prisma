// Plane-local persistence for the shared Command and Workflow contracts.
// Actor, authority, and target references intentionally remain generic so this
// authoritative plane can resolve and persist its own identity and domain state.
model CommandExecution {
  id String @id @db.VarChar(255)

  plane                     String  @db.VarChar(32)
  commandName               String  @db.VarChar(200)
  commandVersion            Int
  actionLevel               String  @db.VarChar(32)
  idempotencyKey            String  @db.VarChar(200)
  requestDigestVersion      Int     @default(1)
  inputDigest               String  @db.Char(64)
  commandBindingHashVersion Int?
  commandBindingHash        String? @db.Char(64)
  grantUse                  Json?
  redactedInput             Json

  actorType String @db.VarChar(64)
  actorId   String @db.VarChar(255)
  actor     Json

  authorityType String @db.VarChar(64)
  authorityId   String @db.VarChar(255)
  authority     Json

  targetType String @db.VarChar(64)
  targetId   String @db.VarChar(255)
  target     Json

  approvalId String?   @unique @db.VarChar(255)
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  confirmationId String?       @unique @db.VarChar(255)
  confirmation   Confirmation? @relation(fields: [confirmationId], references: [id], onDelete: Restrict)

  status         String    @default("pending") @db.VarChar(32)
  result         Json?
  failure        Json?
  leaseOwner     String?   @db.VarChar(255)
  leaseExpiresAt DateTime?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  workflows             Workflow[]
  auditEvents           AuditEvent[]
  standingPermissionUse StandingPermissionUseReservation?

  @@unique([plane, actorType, actorId, targetType, targetId, commandName, commandVersion, idempotencyKey], map: "CommandExecution_scope_idempotency_key")
  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("CommandExecution")
}

model AuditEvent {
  id        String @id @db.VarChar(255)
  sequence  BigInt @unique @default(autoincrement())
  version   Int
  plane     String @db.VarChar(32)
  eventType String @db.VarChar(200)

  actorType String @db.VarChar(64)
  actorId   String @db.VarChar(255)
  actor     Json

  authorityType String @db.VarChar(64)
  authorityId   String @db.VarChar(255)
  authority     Json

  targetType String @db.VarChar(64)
  targetId   String @db.VarChar(255)
  target     Json

  commandName    String? @db.VarChar(200)
  commandVersion Int?

  commandExecutionId String?           @db.VarChar(255)
  commandExecution   CommandExecution? @relation(fields: [commandExecutionId], references: [id], onDelete: Restrict)
  workflowId         String?           @db.VarChar(255)
  workflow           Workflow?         @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now())
  data       Json

  @@index([plane, eventType, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([commandExecutionId])
  @@index([workflowId])
  @@map("AuditEvent")
}

model Workflow {
  id      String @id @db.VarChar(255)
  version Int
  plane   String @db.VarChar(32)
  name    String @db.VarChar(200)
  state   String @default("pending") @db.VarChar(32)

  targetType String @db.VarChar(64)
  targetId   String @db.VarChar(255)
  target     Json

  commandExecutionId String?           @db.VarChar(255)
  commandExecution   CommandExecution? @relation(fields: [commandExecutionId], references: [id], onDelete: Restrict)

  currentStep String?   @db.VarChar(200)
  failure     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  completedAt DateTime?

  steps       WorkflowStep[]
  auditEvents AuditEvent[]

  @@index([commandExecutionId])
  @@index([targetType, targetId, state])
  @@index([state, updatedAt])
  @@map("Workflow")
}

model WorkflowStep {
  id         String   @id @default(uuid()) @db.VarChar(255)
  workflowId String   @db.VarChar(255)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  name              String    @db.VarChar(200)
  position          Int
  state             String    @default("pending") @db.VarChar(32)
  providerReference String?   @db.VarChar(500)
  failure           Json?
  leaseOwner        String?   @db.VarChar(255)
  leaseExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  completedAt       DateTime?

  attempts WorkflowAttempt[]

  @@unique([workflowId, position])
  @@index([state, leaseExpiresAt])
  @@map("WorkflowStep")
}

model WorkflowAttempt {
  id     String       @id @default(uuid()) @db.VarChar(255)
  stepId String       @db.VarChar(255)
  step   WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Restrict)

  attempt           Int
  state             String    @default("pending") @db.VarChar(32)
  operationKey      String    @db.VarChar(500)
  providerReference String?   @db.VarChar(500)
  failure           Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?

  @@unique([stepId, attempt])
  @@index([operationKey])
  @@index([state, startedAt])
  @@map("WorkflowAttempt")
}

model ChangeSet {
  id                   String @id @db.VarChar(255)
  version              Int
  changeSetHashVersion Int    @default(1)
  ownerPlane           String @db.VarChar(32)
  status               String @default("draft") @db.VarChar(32)
  reviewHash           String @db.Char(64)

  targetType String @db.VarChar(64)
  targetId   String @db.VarChar(255)
  target     Json
  proposal   Json

  supersedesChangeSetId String?     @db.VarChar(255)
  supersedes            ChangeSet?  @relation("ChangeSetLineage", fields: [supersedesChangeSetId], references: [id], onDelete: Restrict)
  supersededBy          ChangeSet[] @relation("ChangeSetLineage")

  baseRevisions       Json
  affectedTargets     Json
  beforeSummary       Json
  afterSummary        Json
  publicEffects       Json
  operationalEffects  Json
  estimatedCharges    Json
  requiredPermissions Json
  validationBlocks    Json
  rollbackCoverage    String @db.VarChar(32)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  immutableAt DateTime?

  approvals Approval[]

  @@index([ownerPlane, targetType, targetId, status])
  @@index([reviewHash])
  @@index([supersedesChangeSetId])
  @@map("ChangeSet")
}

model Approval {
  id            String    @id @default(uuid()) @db.VarChar(255)
  changeSetId   String    @db.VarChar(255)
  changeSet     ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Restrict)
  reviewHash    String    @db.Char(64)
  baseRevisions Json

  actorType String @db.VarChar(64)
  actorId   String @db.VarChar(255)
  actor     Json

  authorityType String @db.VarChar(64)
  authorityId   String @db.VarChar(255)
  authority     Json

  approvedAt    DateTime  @default(now())
  invalidatedAt DateTime?

  commandExecution CommandExecution?

  @@unique([changeSetId, reviewHash, actorType, actorId])
  @@index([actorType, actorId, approvedAt])
  @@map("Approval")
}

model Confirmation {
  id        String @id @db.VarChar(255)
  actorType String @db.VarChar(64)
  actorId   String @db.VarChar(255)
  actor     Json

  sessionId String @db.VarChar(255)

  targetType String @db.VarChar(64)
  targetId   String @db.VarChar(255)
  target     Json

  commandName        String    @db.VarChar(200)
  commandVersion     Int
  bindingHashVersion Int
  bindingHash        String    @db.Char(64)
  nonceDigest        String    @unique @db.Char(64)
  disclosure         String    @db.Text
  amount             Decimal?  @db.Decimal(65, 0)
  currency           String?   @db.Char(3)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?

  commandExecution CommandExecution?

  @@index([actorType, actorId, sessionId, expiresAt])
  @@index([targetType, targetId, expiresAt])
  @@map("Confirmation")
}

model StandingPermission {
  id String @id @db.VarChar(255)

  granteeType String @db.VarChar(64)
  granteeId   String @db.VarChar(255)
  grantee     Json

  grantorType String @db.VarChar(64)
  grantorId   String @db.VarChar(255)
  grantor     Json

  authorityType String @db.VarChar(64)
  authorityId   String @db.VarChar(255)
  authority     Json

  businessId String  @db.VarChar(255)
  storeId    String? @db.VarChar(255)

  actionName    String   @db.VarChar(200)
  actionVersion Int
  validFrom     DateTime
  validUntil    DateTime

  perOperationAmount Decimal?  @db.Decimal(65, 0)
  aggregateAmount    Decimal?  @db.Decimal(65, 0)
  currency           String?   @db.Char(3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  revokedAt          DateTime?

  useReservations StandingPermissionUseReservation[]

  @@index([granteeType, granteeId, businessId, storeId, actionName, actionVersion], map: "StandingPermission_scope_idx")
  @@index([validUntil, revokedAt])
  @@map("StandingPermission")
}

model StandingPermissionUseReservation {
  id                   String             @id @default(uuid()) @db.VarChar(255)
  standingPermissionId String             @db.VarChar(255)
  standingPermission   StandingPermission @relation(fields: [standingPermissionId], references: [id], onDelete: Restrict)
  commandExecutionId   String             @db.VarChar(255)
  commandExecution     CommandExecution   @relation(fields: [commandExecutionId], references: [id], onDelete: Restrict)

  amount    Decimal? @db.Decimal(65, 0)
  currency  String?  @db.Char(3)
  state     String   @default("reserved") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([commandExecutionId], map: "StandingPermissionUseReservation_commandExecutionId_key")
  @@index([standingPermissionId, state])
  @@map("StandingPermissionUseReservation")
}
