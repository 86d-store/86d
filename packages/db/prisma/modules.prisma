// Intentional duplicate of packages/core/prisma/modules.prisma
model Module {
    id   String @id @unique @default(uuid()) @db.Uuid
    cuid String @unique @default(cuid(2)) @db.VarChar(30)

    name      String
    version   String
    isEnabled Boolean @default(true)
    settings  Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    data           ModuleData[]
    eventSequences ModuleEventSequence[] @relation("ModuleEventSequenceOwner")
    outboxEvents   ModuleOutboxEvent[]    @relation("ModuleOutboxOwner")
    store          Json? // Store data when created from 86d.app
    storeId        String? @db.Uuid // Store ID when created from 86d.app

    @@unique([storeId, name])
    @@unique([id, storeId, name], map: "Module_outbox_owner_key")
    @@map("Module")
}

model ModuleEventSequence {
    storeId         String @db.Uuid
    sourceModule    String @db.VarChar(100)
    aggregateType   String @db.VarChar(100)
    aggregateId     String @db.VarChar(255)
    lastSequence    BigInt

    module Module @relation("ModuleEventSequenceOwner", fields: [storeId, sourceModule], references: [storeId, name], onDelete: Restrict, onUpdate: Restrict)

    @@id([storeId, sourceModule, aggregateType, aggregateId])
    @@map("ModuleEventSequence")
}

model ModuleOutboxEvent {
    id                String   @id @db.Uuid
    eventType         String   @db.VarChar(200)
    schemaVersion     Int
    storeId           String   @db.Uuid
    sourceModule      String   @db.VarChar(100)
    aggregateType     String   @db.VarChar(100)
    aggregateId       String   @db.VarChar(255)
    aggregateSequence BigInt
    occurredAt        DateTime
    payload           Json
    deliveryState     String   @default("pending") @db.VarChar(32)
    attempts          Int      @default(0)
    nextAttemptAt     DateTime @default(now())
    deliveredAt       DateTime?
    createdAt         DateTime @default(now())

    moduleId   String                @db.Uuid
    module     Module                @relation("ModuleOutboxOwner", fields: [moduleId, storeId, sourceModule], references: [id, storeId, name], onDelete: Restrict, onUpdate: Restrict)
    deliveries ModuleEventDelivery[]

    @@unique([storeId, sourceModule, aggregateType, aggregateId, aggregateSequence], name: "module_event_aggregate_sequence", map: "ModuleOutboxEvent_aggregate_order_key")
    @@index([deliveryState, nextAttemptAt, occurredAt, id], map: "ModuleOutboxEvent_delivery_claim_idx")
    @@map("ModuleOutboxEvent")
}

model ModuleEventDelivery {
    eventId        String   @db.Uuid
    consumer       String   @db.VarChar(200)
    state          String   @default("pending") @db.VarChar(32)
    attempts       Int      @default(0)
    nextAttemptAt  DateTime @default(now())
    leaseToken     String?  @db.Uuid
    leaseOwner     String?  @db.VarChar(200)
    leaseExpiresAt DateTime?
    lastError      String?  @db.VarChar(500)
    succeededAt    DateTime?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    event       ModuleOutboxEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
    consumption ModuleEventConsumption?

    @@id([consumer, eventId])
    @@index([consumer, state, nextAttemptAt, eventId], map: "ModuleEventDelivery_claim_idx")
    @@index([consumer, state, leaseExpiresAt, eventId], map: "ModuleEventDelivery_lease_idx")
    @@index([eventId], map: "ModuleEventDelivery_eventId_idx")
    @@map("ModuleEventDelivery")
}

model ModuleEventConsumption {
    consumer   String   @db.VarChar(200)
    eventId    String   @db.Uuid
    consumedAt DateTime @default(now())

    delivery ModuleEventDelivery @relation(fields: [consumer, eventId], references: [consumer, eventId], onDelete: Restrict, onUpdate: Restrict)

    @@id([consumer, eventId])
    @@map("ModuleEventConsumption")
}

model ModuleData {
    id   String @id @unique @default(uuid()) @db.Uuid
    cuid String @unique @default(cuid(2)) @db.VarChar(30)

    // Entity type for querying (e.g., "cart", "cartItem", "order")
    entityType String @db.VarChar(100)
    // Module-defined entity ID (e.g., "cart_123", "item_456")
    entityId   String @db.VarChar(255)
    data       Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    moduleId String       @db.Uuid
    module   Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    children ModuleData[] @relation("ModuleDataParent")
    parentId String?      @db.Uuid
    parent   ModuleData?  @relation("ModuleDataParent", fields: [parentId], references: [id], onDelete: Cascade)

    // Performance indexes
    @@unique([moduleId, entityType, entityId], name: "module_entity_unique")
    @@index([moduleId, entityType])
    @@index([moduleId, parentId])
    @@index([entityType, entityId])
    @@map("ModuleData")
}
