{
	"name": "@86d-app/contracts",
	"version": "0.0.42",
	"description": "Immutable versioned Command and Change Set conformance contracts for 86d Control Plane and Store Runtime",
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "packages/contracts"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"exports": {
		"./command": {
			"types": "./src/command.ts",
			"default": "./src/command.ts"
		},
		"./change-set": {
			"types": "./src/change-set.ts",
			"default": "./src/change-set.ts"
		},
		"./json-value": {
			"types": "./src/json-value.ts",
			"default": "./src/json-value.ts"
		},
		"./serialize": {
			"types": "./src/serialize.ts",
			"default": "./src/serialize.ts"
		},
		"./conformance": {
			"types": "./src/conformance.ts",
			"default": "./src/conformance.ts"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc && bun ./scripts/rewrite-dist-extensions.ts && bun ../../internals/generators/src/copy-package-assets.ts",
		"check": "biome check src scripts",
		"check:fix": "biome check --write --unsafe src scripts",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"generate:conformance": "bun ./scripts/generate-conformance.ts",
		"pack:artifact": "bun pm pack --quiet",
		"pack:release": "bun ./scripts/pack-release.ts",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./command": {
				"types": "./dist/command.d.ts",
				"default": "./dist/command.js"
			},
			"./change-set": {
				"types": "./dist/change-set.d.ts",
				"default": "./dist/change-set.js"
			},
			"./json-value": {
				"types": "./dist/json-value.d.ts",
				"default": "./dist/json-value.js"
			},
			"./serialize": {
				"types": "./dist/serialize.d.ts",
				"default": "./dist/serialize.js"
			},
			"./conformance": {
				"types": "./dist/conformance.d.ts",
				"default": "./dist/conformance.js"
			}
		}
	}
}
