{
	"name": "@86d-app/storage",
	"version": "0.0.41",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "packages/storage"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./factory": {
			"types": "./src/factory.ts",
			"default": "./src/factory.ts"
		},
		"./local": {
			"types": "./src/local.ts",
			"default": "./src/local.ts"
		},
		"./s3": {
			"types": "./src/s3.ts",
			"default": "./src/s3.ts"
		},
		"./vercel": {
			"types": "./src/vercel.ts",
			"default": "./src/vercel.ts"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc && bun ../../internals/generators/src/copy-package-assets.ts",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:node",
		"@vercel/blob": "2.8.0",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"@vercel/blob": "2.8.0"
	},
	"peerDependenciesMeta": {
		"@vercel/blob": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./types": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.js"
			},
			"./factory": {
				"types": "./dist/factory.d.ts",
				"default": "./dist/factory.js"
			},
			"./local": {
				"types": "./dist/local.d.ts",
				"default": "./dist/local.js"
			},
			"./s3": {
				"types": "./dist/s3.d.ts",
				"default": "./dist/s3.js"
			},
			"./vercel": {
				"types": "./dist/vercel.d.ts",
				"default": "./dist/vercel.js"
			}
		}
	}
}
