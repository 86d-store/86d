	],
	"scripts": {
		"build": "tsc && bun ./scripts/rewrite-dist-imports.ts && bun ../../internals/generators/src/copy-package-assets.ts",
		"check": "biome check --config-path ../../biome.json src scripts",
		"check:fix": "biome check --write --unsafe --config-path ../../biome.json src scripts",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"ui-add": "bunx shadcn@latest add"
	},
