{
	"name": "@86d-app/ui",
	"version": "0.0.42",
	"description": "Shared merchant UI primitives, Console compositions, and TanStack Table data tables for 86d",
	"keywords": [
		"86d",
		"ui",
		"react",
		"data-table",
		"tanstack-table"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./globals.css": "./src/globals.css",
		"./assets/*.png": "./src/assets/*.png",
		"./assets/*.svg": "./src/assets/*.svg",
		"./*": "./src/*"
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc && bun ./scripts/rewrite-dist-imports.ts && bun ../../internals/generators/src/copy-package-assets.ts",
		"check": "biome check --config-path ../../biome.json src scripts",
		"check:fix": "biome check --write --unsafe --config-path ../../biome.json src scripts",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"ui-add": "bunx shadcn@latest add"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@lobehub/icons": "5.16.0",
		"@phosphor-icons/react": "2.1.10",
		"@radix-ui/react-slot": "1.3.3",
		"@shadcn/react": "0.3.0",
		"@tailwindcss/typography": "0.5.20",
		"@tanstack/react-table": "9.1.2",
		"@toolwind/corner-shape": "0.0.8-3",
		"boneyard-js": "1.9.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"dayjs": "1.11.21",
		"embla-carousel-react": "8.6.0",
		"input-otp": "1.4.2",
		"mobx": "7.0.0",
		"mobx-react-lite": "5.0.0",
		"next-themes": "catalog:next",
		"react-day-picker": "10.0.1",
		"react-resizable-panels": "4.12.2",
		"recharts": "3.10.1",
		"shadcn": "4.18.0",
		"slugify": "1.6.9",
		"sonner": "2.0.8",
		"tailwind-merge": "3.6.0",
		"tailwindcss": "catalog:",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"peerDependencies": {
		"@tanstack/react-table": "9.1.2",
		"next": "catalog:next",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"zod": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./package.json": "./package.json",
			"./globals.css": "./dist/globals.css",
			"./assets/*.png": "./dist/assets/*.png",
			"./assets/*.svg": "./dist/assets/*.svg",
			"./*": {
				"types": "./dist/*.d.ts",
				"default": "./dist/*.js"
			}
		}
	}
}
