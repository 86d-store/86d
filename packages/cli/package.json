{
	"name": "86d",
	"version": "0.0.41",
	"description": "CLI for 86d \u2014 modular, open-source commerce platform",
	"keywords": [
		"86d",
		"commerce",
		"ecommerce",
		"modular",
		"cli"
	],
	"homepage": "https://86d.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": "86d <chat@86d.app>",
	"type": "module",
	"bin": {
		"86d": "./bin/86d.mjs"
	},
	"files": [
		"bin",
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc && chmod +x dist/index.js",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsx src/index.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@86d-app/core": "workspace:*",
		"@86d-app/registry": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:node",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"86d": "./dist/index.js"
		}
	}
}
