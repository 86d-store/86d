{
	"name": "@86d-app/registry",
	"version": "0.0.42",
	"description": "Module registry for 86d \u2014 resolve, fetch, and cache modules from local, GitHub, or npm sources",
	"repository": {
		"type": "git",
		"url": "https://github.com/86d-app/86d.git",
		"directory": "packages/registry"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		"./admission": {
			"types": "./src/admission.ts",
			"default": "./src/admission.ts"
		},
		"./config": {
			"types": "./src/config.ts",
			"default": "./src/config.ts"
		},
		"./fetcher": {
			"types": "./src/fetcher.ts",
			"default": "./src/fetcher.ts"
		},
		"./integrity": {
			"types": "./src/integrity.ts",
			"default": "./src/integrity.ts"
		},
		"./lockfile": {
			"types": "./src/lockfile.ts",
			"default": "./src/lockfile.ts"
		},
		"./manifest": {
			"types": "./src/manifest.ts",
			"default": "./src/manifest.ts"
		},
		"./maturity": {
			"types": "./src/maturity.ts",
			"default": "./src/maturity.ts"
		},
		"./paths": {
			"types": "./src/paths.ts",
			"default": "./src/paths.ts"
		},
		"./resolver": {
			"types": "./src/resolver.ts",
			"default": "./src/resolver.ts"
		},
		"./specifier": {
			"types": "./src/specifier.ts",
			"default": "./src/specifier.ts"
		},
		"./template": {
			"types": "./src/template.ts",
			"default": "./src/template.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		}
	},
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"!dist/**/*.test.d.ts.map",
		"README.md"
	],
	"scripts": {
		"build": "tsc && bun ../../internals/generators/src/copy-package-assets.ts",
		"check": "biome check src",
		"check:fix": "biome check --write --unsafe src",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"env": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:node",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./admission": {
				"types": "./dist/admission.d.ts",
				"default": "./dist/admission.js"
			},
			"./config": {
				"types": "./dist/config.d.ts",
				"default": "./dist/config.js"
			},
			"./fetcher": {
				"types": "./dist/fetcher.d.ts",
				"default": "./dist/fetcher.js"
			},
			"./integrity": {
				"types": "./dist/integrity.d.ts",
				"default": "./dist/integrity.js"
			},
			"./lockfile": {
				"types": "./dist/lockfile.d.ts",
				"default": "./dist/lockfile.js"
			},
			"./manifest": {
				"types": "./dist/manifest.d.ts",
				"default": "./dist/manifest.js"
			},
			"./maturity": {
				"types": "./dist/maturity.d.ts",
				"default": "./dist/maturity.js"
			},
			"./paths": {
				"types": "./dist/paths.d.ts",
				"default": "./dist/paths.js"
			},
			"./resolver": {
				"types": "./dist/resolver.d.ts",
				"default": "./dist/resolver.js"
			},
			"./specifier": {
				"types": "./dist/specifier.d.ts",
				"default": "./dist/specifier.js"
			},
			"./template": {
				"types": "./dist/template.d.ts",
				"default": "./dist/template.js"
			},
			"./types": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.js"
			}
		}
	}
}
