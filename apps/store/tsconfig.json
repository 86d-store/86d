{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "dom", "dom.iterable"],
		"types": ["node", "mdx"],
		"jsx": "preserve",
		"paths": {
			"*": ["./*"],
			"~/*": ["./*"],
			"template/*": ["../../templates/brisa/*"],
			"@86d-app/*/components": ["../../modules/*/src/store/components/mdx.tsx"],
			"lib/*": ["../../packages/lib/src/*"]
		},
		"plugins": [{ "name": "next" }],
		"module": "esnext"
	},
	"include": [".", ".next/types/**/*.ts"],
	"exclude": ["node_modules", "lib/__tests__"]
}
