{
	"name": "@86d-app/86d",
	"version": "0.0.4",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "dotenv -- turbo run build",
		"build:apps": "turbo run build --filter=./apps/*",
		"build:packages": "turbo run build --filter=./packages/*",
		"build:store": "turbo run build --filter=./apps/store",
		"typecheck": "turbo run typecheck",
		"check": "biome check .",
		"check:fix": "biome check --write --unsafe .",
		"clean": "turbo run clean && git clean -xdf .turbo .next node_modules coverage logs playwright-report",
		"dev": "dotenv -- turbo run dev --filter=store",
		"dev:store": "dotenv -- turbo run dev --filter=store",
		"start": "turbo run start",
		"test": "turbo run test -- --exclude='**/dist/**'",
		"test:coverage": "vitest run --coverage --config tests/vitest.config.ts",
		"test:e2e": "playwright test --config tests/playwright.config.ts",
		"test:e2e:store": "playwright test --config tests/playwright.config.ts --project=store-chromium",
		"test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
		"postinstall": "bun run generate:modules -- --frozen",
		"generate:modules": "tsx internals/generators/src/generate-modules.ts",
		"compile:schema": "tsx internals/generators/src/compile-module-schema.ts",
		"generate:registry": "tsx apps/registry/src/generate-manifest.ts",
		"generate:docs": "tsx internals/generators/src/generate-component-docs.ts",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build --filter=./packages/* --filter=./modules/* && changeset publish",
		"86d": "tsx packages/cli/src/index.ts",
		"db:migrate": "dotenv -- bun run --filter db migrate",
		"db:seed": "dotenv -- bun run --filter db seed",
		"seed:fetch-luxury-assets": "bun run --filter db seed:fetch-luxury-assets",
		"bump-version": "tsx internals/generators/src/bump-version.ts",
		"install:ci": "bun install --frozen-lockfile",
		"audit": "bun pm untrusted && npm audit --audit-level=high",
		"prepare": "husky"
	},
	"dependencies": {
		"@86d-app/registry": "workspace:*",
		"tsx": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.3",
		"@biomejs/biome": "catalog:",
		"@changesets/changelog-github": "0.7.0",
		"@changesets/cli": "2.31.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@playwright/test": "1.61.0",
		"@socketsecurity/bun-security-scanner": "1.1.2",
		"@tsconfig/node-ts": "catalog:",
		"@tsconfig/node24": "catalog:",
		"@tsconfig/strictest": "catalog:",
		"@types/node": "catalog:node",
		"@types/pg": "8.20.0",
		"@vitest/coverage-v8": "4.1.9",
		"dotenv-cli": "catalog:",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"pg": "8.21.0",
		"sharp": "0.35.1",
		"turbo": "catalog:",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:vite"
	},
	"engines": {
		"node": "23 || 24 || 25"
	},
	"playwright": {
		"config": "tests/playwright.config.ts"
	},
	"workspaces": [
		"apps/*",
		"internals/*",
		"modules/*",
		"packages/*"
	],
	"catalog": {
		"@biomejs/biome": "2.5.6",
		"@tsconfig/node-ts": "23.6.4",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/strictest": "2.0.8",
		"dotenv-cli": "11.0.0",
		"@tailwindcss/postcss": "4.3.0",
		"postcss": "8.5.14",
		"slug": "11.0.1",
		"tailwindcss": "4.3.0",
		"tsx": "4.22.4",
		"turbo": "2.9.18",
		"type-fest": "5.7.0",
		"typescript": "6.0.3",
		"zod": "4.4.3"
	},
	"catalogs": {
		"mdx": {
			"@mdx-js/loader": "3.1.1",
			"@mdx-js/react": "3.1.1",
			"@next/mdx": "16.2.6",
			"@types/mdx": "2.0.13"
		},
		"next": {
			"@next/third-parties": "16.2.6",
			"@types/next": "9.0.0",
			"next": "16.2.6",
			"next-themes": "0.4.6"
		},
		"node": {
			"@types/node": "25.9.3"
		},
		"react": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"react": "19.2.6",
			"react-dom": "19.2.6",
			"react-use": "17.6.0"
		},
		"trpc": {
			"@tanstack/react-query": "5.100.10"
		},
		"vercel": {
			"@vercel/analytics": "2.0.1"
		},
		"vite": {
			"vite": "8.0.13",
			"vite-tsconfig-paths": "6.1.1",
			"vitest": "4.1.9"
		}
	},
	"packageManager": "bun@1.3.6",
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}
