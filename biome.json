{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"domains": {
			"next": "all",
			"react": "recommended",
			"tailwind": "all",
			"turborepo": "all",
			"types": "all",
			"test": "all",
			"playwright": "all"
		},
		"rules": {
			"a11y": {
				"useSemanticElements": "error"
			},
			"complexity": {
				"useMaxParams": "error"
			},
			"correctness": {
				"noPrivateImports": "error",
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				},
				"noUnusedVariables": {
					"level": "error",
					"fix": "safe"
				},
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error"
			},
			"nursery": {
				"recommended": true,
				"noConditionalExpect": "error",
				"noPlaywrightNetworkidle": "error",
				"noPlaywrightWaitForSelector": "error",
				"noPlaywrightWaitForTimeout": "error",
				"useExpect": "error",
				"useSortedClasses": {
					"level": "error",
					"fix": "safe"
				}
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noBarrelFile": "error",
				"noDelete": "error",
				"noImgElement": "error",
				"noNamespaceImport": "error",
				"noReExportAll": "error",
				"noSyncScripts": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error",
				"noGlobalEval": "error"
			},
			"style": {
				"noEnum": "error",
				"noExportedImports": "error",
				"noInferrableTypes": "error",
				"noNamespace": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"noProcessEnv": "error",
				"noYodaExpression": "error",
				"useCollapsedIf": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"useThrowOnlyError": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["error", "warn"]
					}
				},
				"noArrayIndexKey": "error",
				"noEvolvingTypes": "error",
				"noFocusedTests": "error",
				"noImplicitAnyLet": "error",
				"noImportCycles": "error",
				"noSkippedTests": "error",
				"noTsIgnore": "error",
				"noUndeclaredEnvVars": "error",
				"noUnnecessaryConditions": "error",
				"useArraySortCompare": "error",
				"useBiomeIgnoreFolder": "error",
				"useErrorMessage": "error"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "on",
				"useSortedPackageJson": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/ui/src/shadcn/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"noLabelWithoutControl": "off",
						"useFocusableInteractive": "off",
						"useKeyWithClickEvents": "off",
						"useAriaPropsForRole": "off"
					},
					"performance": {
						"noNamespaceImport": "off",
						"noBarrelFile": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"style": {
						"noExportedImports": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDocumentCookie": "off",
						"noUnnecessaryConditions": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/core/src/schema/index.ts",
				"packages/core/src/graph/index.ts",
				"packages/core/src/commands.ts"
			],
			"linter": {
				"rules": {
					"performance": {
						"noBarrelFile": "off"
					},
					"style": {
						"noExportedImports": "off"
					}
				}
			}
		}
	],
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"apps/**",
			"modules/**",
			"packages/**",
			"tests/**",
			"templates/**",
			"internals/**",
			"!**/dist",
			"!**/.dist",
			"!**/.turbo",
			"!**/.vercel",
			"!**/.next",
			"!**/.cache",
			"!**/node_modules",
			"!**/coverage",
			"!**/build",
			"!**/out",
			"!**/e2e/.results",
			"!**/e2e/.auth",
			"!**/e2e/.snapshots",
			"!apps/registry/registry.json",
			"!apps/registry/registry.lock.json",
			"!packages/db/drizzle",
			"!packages/contracts/src/generated",
			"!packages/contracts/dist/generated",
			"!apps/store/generated",
			"!**/*.min.js",
			"!**/*.tsbuildinfo"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
